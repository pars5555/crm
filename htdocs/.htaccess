# Never print PHP errors into pages (visitors must not see file paths or stack details);
# they go to the web server error log instead (docker logs crm-web)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag display_startup_errors off
    php_flag log_errors on
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

<IfModule mod_headers.c>
    # basic hardening headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
    Header always unset X-Powered-By
    # clickjacking protection for the admin UI; the public share pages may still be embedded
    SetEnvIf Request_URI "^/(sharewarehouse|onevanilla|partner/share)" allow_frame
    Header always set X-Frame-Options "SAMEORIGIN" env=!allow_frame

    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # the bundled files carry their content hash in the name, so they can be cached for a year
    <If "%{REQUEST_URI} =~ m#^/assets/app\.[0-9a-f]+\.(js|css)$#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# friendly page instead of a blank screen when a request ends in a server error
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/500.html
ErrorDocument 503 /errors/500.html

RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule . index.php [L]
